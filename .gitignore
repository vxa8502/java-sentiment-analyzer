# Build artifacts
target/
*.class

# IDE files
.idea/
*.iml
.vscode/
*.swp
*.swo
.classpath
.project
.settings/

# Python cache (scripts use Python)
**/__pycache__/
*.pyc
*.pyo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/
training_log*.txt

# Data (large files - download via scripts/download_data.sh)
/data/

# Model files
# Training models ignored, only production tracked
models/svm/
models/naive_bayes/
models/random_forest/
models/logistic_regression/
!models/production/
!models/production/*

# Data cards MUST be tracked (dataset documentation)
!docs/data_cards/
!docs/data_cards/*

# Archives
*.tar.gz
*.zip

# Environment files
.env
.env.*
.env*.local
application-local.properties

# Personal notes
personal/

# Temporary and backup files
*.tmp
*.temp
*.bak
*~

# Test scripts in root
test_*.sh

# Generated results (metrics in README)
results/

# Dev-only scripts
scripts/reset.sh
scripts/cleanup.sh
scripts/generate_report.sh
