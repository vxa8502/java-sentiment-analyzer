# Build artifacts
target/
*.jar
*.class
*.war

# IDE files
.idea/
*.iml
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/
training_log*.txt

# Data directories (local only - not version controlled)
/data/
*.csv
*.tsv
*.parquet

# Model files - ONLY production model is in git (via Git LFS)
# Training models are generated locally via scripts/train_all_models.sh
# Only .ser files ignored - metadata (.json) is tracked as proof of work
models/svm/*.ser
models/naive_bayes/*.ser
models/random_forest/*.ser
models/logistic_regression/*.ser
# Production model is tracked via Git LFS (.gitattributes)

# Compressed model archives
*.tar.gz
*.zip

# Experiments (can be large)
experiments/*/model_artifacts/

# Environment files
.env
application-local.properties

# Personal notes
personal/

# Temporary files
*.tmp
*.temp

# Test scripts in root (move to scripts/ if needed)
test_*.sh

# Regeneratable results (run scripts to regenerate)
results/error_analysis/
docs/data_cards/*_quality_report.json

# Old/superseded reports
results/REPORT.md
results/CROSS_DOMAIN_FINAL_REPORT.md
DATA_QUALITY_FINDINGS.md
personal_notes/
