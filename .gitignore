# Build artifacts
target/
*.class

# IDE files
.idea/
*.iml
.vscode/
*.swp
*.swo
.classpath
.project
.settings/

# Python cache (scripts use Python)
**/__pycache__/
*.pyc
*.pyo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/
training_log*.txt

# Data (large CSV files - download via scripts/download_data.sh)
data/**/*.csv
data/predictions/

# Model files
# Binary model files ignored (large), metadata tracked
models/**/*.ser
!models/production/*.ser

# Data cards MUST be tracked (dataset documentation)
!docs/data_cards/
!docs/data_cards/*

# Archives
*.tar.gz
*.zip

# Environment files
.env
.env.*
.env*.local
application-local.properties

# Personal notes
home/

# Temporary and backup files
*.tmp
*.temp
*.bak
*~

# Test scripts in root
test_*.sh

# Dev-only scripts
scripts/cleanup.sh
