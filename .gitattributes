# Git LFS configuration for production model ONLY
# Other models are gitignored and downloadable via scripts/download_pretrained_models.sh
models/production/*.ser filter=lfs diff=lfs merge=lfs -text
models/production/*.model filter=lfs diff=lfs merge=lfs -text

# Ensure shell scripts have correct line endings
*.sh text eol=lf

# Ensure JSON and YAML files are treated as text
*.json text
*.yaml text
*.yml text
